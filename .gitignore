# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# 本地数据库与密钥（运行时在服务器生成，绝不入库）
*.db
*.sqlite
*.sqlite3
.env
.env.*
server/.apikey
server/.adminkey

# macOS
.DS_Store
._*
.AppleDouble

# 编辑器 / 临时
*.swp
*.swo
.idea/
.vscode/
*.log

# 测试目录：E2E 脚本与截图只留本地；API 回归框架与对象模型单测需入库，作为重构护栏
tests/**
!tests/api/
!tests/api/*.py
!tests/js/
!tests/js/*.js
# 契约矩阵的唯一事实源必须入库（Python 链路矩阵与 JS 对象/浏览器矩阵共用）
!tests/contracts.json
